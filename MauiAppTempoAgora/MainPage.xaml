<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTempoAgora.MainPage"
             Title="Tempo Agora"
             BackgroundColor="#F4F7FA">

    <ScrollView>

        <VerticalStackLayout Padding="30"
                             Spacing="20"
                             MaximumWidthRequest="600"
                             HorizontalOptions="Center">

            <!-- Título -->
            <Label Text="🌤️ Tempo Agora"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1F2937"
                   Margin="0,20,0,10" />

            <Label Text="Consulte o clima da sua cidade"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="#6B7280"
                   Margin="0,0,0,10" />

            <!-- Campo da cidade -->
            <Border Stroke="#D1D5DB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Padding="5">

                <Entry x:Name="txt_cidade"
                       Placeholder="Digite o nome da cidade"
                       FontSize="18"
                       HeightRequest="50"
                       BackgroundColor="Transparent" />

            </Border>

            <!-- Botão -->
            <Button Text="Consultar clima"
                    Clicked="Consultar_Clicked"
                    FontSize="18"
                    HeightRequest="55"
                    CornerRadius="12"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold" />

            <!-- Carregando -->
            <ActivityIndicator x:Name="activity"
                               IsVisible="False"
                               IsRunning="False"
                               HeightRequest="40"
                               HorizontalOptions="Center" />

            <!-- Resultado -->
            <Border Stroke="#D1D5DB"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 15"
                    Padding="20"
                    Margin="0,10,0,0">

                <Label x:Name="lbl_resultado"
                       FontSize="19"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="#1F2937" />

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>